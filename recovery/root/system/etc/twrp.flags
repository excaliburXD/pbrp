# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<mnt_point>             <type>    <device>                                                        <mnt_flags and options>

# User writeable partitions
/boot                     emmc     /dev/block/platform/bootdevice/by-name/boot                     flags=slotselect;backup=1;flashimg=1
/vbmeta                   emmc     /dev/block/platform/bootdevice/by-name/vbmeta                   flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_vendor            emmc     /dev/block/platform/bootdevice/by-name/vbmeta_vendor            flags=display="Vbmeta Vendor";slotselect;backup=1;flashimg=1
/vbmeta_system            emmc     /dev/block/platform/bootdevice/by-name/vbmeta_system            flags=display="Vbmeta System";slotselect;backup=1;flashimg=1

# Firmware & System
/dtbo                     emmc     /dev/block/platform/bootdevice/by-name/dtbo                     flags=display="DTBO";backup=1;flashimg=1
/metadata                 ext4     /dev/block/platform/bootdevice/by-name/md_udc                   flags=display="Metadata";backup=1
/data                     f2fs     /dev/block/platform/bootdevice/by-name/userdata                 flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity
/misc                     emmc     /dev/block/platform/bootdevice/by-name/misc                     flags=display="Misc";backup=1

# Sensitive Data (Non-A/B)
/nvcfg                    ext4     /dev/block/platform/bootdevice/by-name/nvcfg                    flags=display="Nvcfg";backup=1;flashimg=1
/persist                  ext4     /dev/block/platform/bootdevice/by-name/persist                  flags=display="Persist";backup=1;mounttodecrypt
/persist_image            emmc     /dev/block/platform/bootdevice/by-name/persist                  flags=display="Persist Image";backup=1;flashimg=1
/persistent               emmc     /dev/block/platform/bootdevice/by-name/frp                      flags=display="Persistent (FRP)";backup=1

# IMEI and Modem Related (Non-A/B)
/nvdata                   ext4     /dev/block/platform/bootdevice/by-name/nvdata                   flags=display="Nvdata";backup=1;flashimg=1
/protect_f                ext4     /dev/block/platform/bootdevice/by-name/protect1                 flags=display="Protect_f";backup=1;flashimg=1
/protect_s                ext4     /dev/block/platform/bootdevice/by-name/protect2                 flags=display="Protect_s";backup=1;flashimg=1
/nvram                    emmc     /dev/block/platform/bootdevice/by-name/nvram                    flags=display="Nvram";backup=1;flashimg=1

# Mediatek Standard Partitions (Non-A/B)
/bootloader               emmc     /dev/block/platform/bootdevice/by-name/lk                       flags=display="Bootloader";flashimg=1
/expdb                    emmc     /dev/block/platform/bootdevice/by-name/expdb                    flags=display="Expdb";backup=1
/logo                     emmc     /dev/block/platform/bootdevice/by-name/logo                     flags=display="Logo";backup=1;flashimg=1
/otp                      emmc     /dev/block/platform/bootdevice/by-name/otp                      flags=display="Otp";backup=1
/seccfg                   emmc     /dev/block/platform/bootdevice/by-name/seccfg                   flags=display="Seccfg";backup=1
/spmfw                    emmc     /dev/block/platform/bootdevice/by-name/spmfw                    flags=display="Spmfw";backup=1

# External Storage
/storage                  f2fs     /data/media/0                                                   flags=display="Internal Storage";usermrf;backup=1;fsflags="bind";removable
/external_sd              vfat     /dev/block/mmcblk0p1 /dev/block/mmcblk0 /dev/block/mmcblk1p1    flags=display="Micro SD Card";storage;wipeingui;removable;backup=0
/usb_otg                  vfat     /dev/block/sda1 /dev/block/sda /dev/block/sdd1                  flags=display="USB-OTG";storage;wipeingui;removable;backup=0

# Dynamic Partitions (Flashing Image & Backup Individual)
/system_image             emmc     /dev/block/mapper/system                                        flags=backup=1;flashimg=1;slotselect;logical;display="System Image"
/system_ext_image         emmc     /dev/block/mapper/system_ext                                    flags=backup=1;flashimg=1;slotselect;logical;display="System EXT Image"
/vendor_image             emmc     /dev/block/mapper/vendor                                        flags=backup=1;flashimg=1;slotselect;logical;display="Vendor Image"
/product_image            emmc     /dev/block/mapper/product                                       flags=backup=1;flashimg=1;slotselect;logical;display="Product Image"
